---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 - No encontrado" description="Página no encontrada">
    <main class="newsroom-container" style="text-align: center; padding: 6rem 2rem;">
        <h1 style="font-size: 4rem; font-weight: 900; color: var(--text-muted);">404</h1>
        <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">Endpoint no encontrado</h2>
        <p style="color: var(--text-muted); margin-bottom: 2rem;">La ruta que buscas no existe en producción.</p>
        <a href="/hana/" class="read-more" style="font-size: 1.1rem; margin: 0;">Volver al inicio →</a>
    </main>
</BaseLayout>