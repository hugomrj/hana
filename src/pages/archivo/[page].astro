---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }) {
    const articles = await getCollection('blog');
    const sortedArticles = articles.sort((a, b) => new Date(b.data.fecha) - new Date(a.data.fecha));
    // 9 artículos por página
    return paginate(sortedArticles, { pageSize: 9 });
}

const { page } = Astro.props;
---
<BaseLayout title="Archivo" description="Todos los análisis de hana">
    <main class="newsroom-container">
        <section class="news-grid-wrapper">
            <div class="section-header">
                <h2 class="section-title">Archivo de Análisis</h2>
                <p class="section-subtitle">Página {page.currentPage} de {page.lastPage}</p>
            </div>
            
            <div class="news-grid">
                {page.data.map(art => (
                    <a href={`/hana/articulos/${art.id}`} class="news-card">
                        <div class="card-top">
                            <span class="kicker">{art.data.categoria}</span>
                        </div>
                        <h3>{art.data.titulo}</h3>
                        <p>{art.data.extracto}</p>
                        <div class="byline">
                            <span>{new Date(art.data.fecha).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                            <span class="dot">•</span>
                            <span>{art.data.tiempo_lectura}</span>
                        </div>
                    </a>
                ))}
            </div>

            <!-- Navegación de paginación -->
            <div class="pagination">
                {page.currentPage > 1 && (
                    <a href={page.currentPage === 2 ? '/hana/archivo' : `/hana/archivo/${page.currentPage - 1}`} class="read-more">← Anterior</a>
                )}
                {page.currentPage < page.lastPage && (
                    <a href={`/hana/archivo/${page.currentPage + 1}`} class="read-more">Siguiente →</a>
                )}
            </div>
        </section>
    </main>
</BaseLayout>