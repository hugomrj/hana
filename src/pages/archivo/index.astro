---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('blog');
const sortedArticles = articles.sort((a, b) => new Date(b.data.fecha) - new Date(a.data.fecha));
---
<BaseLayout title="Archivo" description="Todos los análisis de hana">
    <main class="newsroom-container">
        <section class="news-grid-wrapper">
            <div class="news-grid">
                {sortedArticles.map(art => (
                    <a href={`/hana/articulos/${art.id}`} class="news-card">
                        <div class="card-top">
                            <span class="kicker">{art.data.categoria}</span>
                        </div>
                        <h3>{art.data.titulo}</h3>
                        <p>{art.data.extracto}</p>
                        <div class="byline">
                            <span>{new Date(art.data.fecha).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                            <span class="dot">•</span>
                            <span>{art.data.tiempo_lectura}</span>
                        </div>
                    </a>
                ))}
            </div>
        </section>
    </main>
</BaseLayout>