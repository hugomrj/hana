---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('blog');
const sortedArticles = articles.sort((a, b) => new Date(b.data.fecha) - new Date(a.data.fecha));
---
<BaseLayout title="Archivo" description="Todos los análisis de hana">
    <main class="newsroom-container" style="max-width: 800px;">
        <section class="news-grid-wrapper">
            <div class="section-header" style="margin-bottom: 2rem;">
                <h2 class="section-title">Archivo</h2>
                <p class="section-subtitle">{sortedArticles.length} análisis publicados</p>
            </div>
            
            <div class="archive-list">
                {sortedArticles.map(art => (
                    <a href={`/hana/articulos/${art.id}`} class="archive-item">
                        <div class="archive-meta">
                            <span class="archive-date">{new Date(art.data.fecha).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                            <span class="kicker">{art.data.categoria}</span>
                        </div>
                        <h3>{art.data.titulo}</h3>
                        <p>{art.data.extracto}</p>
                    </a>
                ))}
            </div>
        </section>
    </main>
</BaseLayout>